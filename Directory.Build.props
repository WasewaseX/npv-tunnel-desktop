<Project>
  <PropertyGroup>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Company>WasewaseX</Company>
    <Authors>WasewaseX</Authors>
    <Product>NPV Tunnel Desktop</Product>
    <Copyright>Copyright (c) 2026 WasewaseX</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The review asked for a build that refuses to hide problems. Every project in
    the solution now compiles warning-free, so a new warning is a mistake to fix
    rather than something to scroll past. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- InvariantGlobalization must stay false: WPF resolves cultures while it
    parses and renders its own templates, so invariant mode makes the first
    window throw CultureNotFoundException (that regression shipped in 1.0.0). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RepositoryUrl>https://github.com/WasewaseX/npv-tunnel-desktop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
