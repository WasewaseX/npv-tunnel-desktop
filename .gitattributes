* text=auto eol=lf
*.sln text eol=crlf
*.ps1 text eol=crlf
*.ico binary
*.dat binary
*.exe binary
# Shell scripts are built into the Linux archive on Windows runners: they must
# keep LF and their execute bit or install.sh arrives unreadable.
*.sh text eol=lf
scripts/linux/* text eol=lf
*.tar.gz binary
# The vendor-format fixture is a hash-checked test input; git must not touch it.
*.npvt binary
