<UserControl x:Class="NpvTunnel.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NpvTunnel.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,14">
            <StackPanel>
                <TextBlock Text="LOGS" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding LogCountLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="FollowToggle" Content="Follow" Style="{StaticResource ToggleSwitch}"
                          IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Content="COPY" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                        FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                        Command="{Binding CopyLogsCommand}" />
                <Button Content="CLEAR" Style="{StaticResource DangerButton}"
                        FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                        Command="{Binding ClearLogsCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="4,10">
            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Style="{StaticResource CleanListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="#FF44544C" />

                            <TextBlock Grid.Column="1" Text="{Binding LevelText}" Margin="10,0,10,0"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LevelText}" Value="WRN">
                                                <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LevelText}" Value="ERR">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="2" Text="{Binding Source, StringFormat=[{0}]}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="#FF5A6B62" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="#FFBECDC4" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
