<UserControl x:Class="NpvTunnel.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NpvTunnel.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid MaxWidth="620" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- LAST PING / PING -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <StackPanel>
                <TextBlock Text="LAST PING" Style="{StaticResource Eyebrow}" />
                <TextBlock Text="{Binding PingText}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="PING" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource BaseButton}" Background="Transparent" BorderBrush="Transparent"
                    Foreground="{StaticResource Teal}" FontSize="13" FontWeight="Bold" Padding="10,4"
                    Command="{Binding PingAllCommand}" />
        </Grid>

        <!-- search, opened from the pill -->
        <Border Grid.Row="1" Margin="0,0,0,10"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVis}}">
            <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by name, host or protocol" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">

                <!-- Smart Route -->
                <Border x:Name="SmartRow" Style="{StaticResource GroupCard}" Background="{StaticResource RowTint}"
                        BorderBrush="{StaticResource RowTintStroke}" Padding="14,12" Cursor="Hand"
                        MouseLeftButtonUp="OnSmartRouteClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Smart Route" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SmartRouteSubtitle}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowIcon}" Content="&#xE73E;" ToolTip="Use fastest"
                                    Foreground="{StaticResource Accent}" Command="{Binding ConnectCommand}" />
                            <Button Style="{StaticResource RowIcon}" Content="&#xE70F;" ToolTip="Export"
                                    Command="{Binding ExportProfileCommand}" />
                            <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" ToolTip="Remove"
                                    Command="{Binding RemoveProfileCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved (n) group header -->
                <Border Style="{StaticResource GroupCard}" Background="{StaticResource CardAlt}" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource RowIcon}" Width="22" Height="22"
                                Margin="0,0,8,0" FontSize="10" Content="{Binding SavedChevron}"
                                Command="{Binding ToggleSavedCommand}" ToolTip="Collapse or expand" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Saved" FontSize="14.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProfileCountLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11.5" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="8,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowIcon}" Content="&#xE73E;" ToolTip="Use"
                                    Foreground="{StaticResource Accent}" Command="{Binding ConnectCommand}" />
                            <Button Style="{StaticResource RowIcon}" Content="&#xE712;" ToolTip="More"
                                    Command="{Binding NavigateCommand}" CommandParameter="settings" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- individual configurations -->
                <ItemsControl ItemsSource="{Binding ProfilesView}"
                              Visibility="{Binding SavedExpanded, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileItemViewModel}">
                            <Border x:Name="Row" Background="{StaticResource Row}" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" CornerRadius="6" Padding="16,11" Margin="0,0,0,6"
                                    MouseLeftButtonUp="OnProfileRowClick" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Endpoint}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Chip}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5" Foreground="{StaticResource Muted}"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PingText}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                                   Foreground="{StaticResource Muted}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE72D;" ToolTip="Export"
                                                Command="{Binding DataContext.ExportProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE70F;" ToolTip="Edit"
                                                Command="{Binding DataContext.ExportProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource RowIcon}" Content="&#xE74D;" ToolTip="Delete"
                                                Command="{Binding DataContext.RemoveProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static vm:IsSelectedConverter.Instance}">
                                            <Binding Path="." />
                                            <Binding Path="DataContext.SelectedProfile"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource RowTint}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Global Network -->
                <Border Style="{StaticResource GroupCard}" Background="{StaticResource CardAlt}" Padding="14,12" Margin="0,2,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Global Network" FontSize="14.5" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FailedCountLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11.5" Foreground="{StaticResource Muted}"
                                           VerticalAlignment="Center" Margin="8,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RowIcon}" Content="&#xE73E;" ToolTip="Check"
                                        Foreground="{StaticResource Accent}" Command="{Binding PingAllCommand}" />
                                <Button Style="{StaticResource RowIcon}" Content="&#xE72C;" ToolTip="Refresh"
                                        Command="{Binding PingAllCommand}" />
                                <Button Style="{StaticResource RowIcon}" Content="&#xE712;" ToolTip="More"
                                        Command="{Binding NavigateCommand}" CommandParameter="logs" />
                            </StackPanel>
                        </Grid>

                        <!-- teal -> mint progress, as on the phone -->
                        <Border Grid.Row="1" Height="5" CornerRadius="3" Background="#FF1B2A22"
                                Margin="0,14,0,0" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding SessionBar}" />
                                    <ColumnDefinition Width="{Binding SessionBarRest}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF2EBFA9" Offset="0" />
                                            <GradientStop Color="#FF3FE58F" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2" Text="{Binding TotalText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <!-- empty state -->
                <Border Style="{StaticResource GroupCard}" Padding="24" Margin="0,10,0,0"
                        Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="No configurations yet" FontSize="14.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Double-click a .npvt file, drag one onto this window, or paste a share link."
                                   Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" MaxWidth="380" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="IMPORT .NPVT" Style="{StaticResource PrimaryButton}"
                                    FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,0,8,0"
                                    Command="{Binding ImportCommand}" />
                            <Button Content="FROM CLIPBOARD" Style="{StaticResource GhostButton}"
                                    FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                    Command="{Binding ImportFromClipboardCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
