<UserControl x:Class="NpvTunnel.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NpvTunnel.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource EyebrowAccent}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,2,10,8">
            <TextBlock Text="MORE" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding AppVersion, StringFormat=NPV Tunnel v{0}}" FontSize="14"
                       FontWeight="SemiBold" Margin="0,4,0,18" />

            <!-- export, mirroring the reference "Export Configuration" flow -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="EXPORT CONFIGURATION" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Export the selected configuration" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Writes an npvt/1 file. Add a passphrase to lock it so recipients can connect but cannot read or edit the endpoint."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button Content="EXPORT" Style="{StaticResource GhostButton}"
                                FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ExportProfileCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- engine -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="TUNNEL ENGINE" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Xray-core" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource RowHint}" />
                            <TextBlock Text="Verified against a SHA-256 digest compiled into this build."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button Content="INSTALL CORE" Style="{StaticResource PrimaryButton}"
                                FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding DownloadEngineCommand}" IsEnabled="{Binding EngineMissing}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Local proxy ports" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Apps that ignore the system proxy can point here directly."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="SOCKS5" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource DarkTextBox}" Width="84" Text="{Binding SocksPort}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="HTTP" Style="{StaticResource Eyebrow}" Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource DarkTextBox}" Width="84" Text="{Binding HttpPort}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- privacy -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="ROUTING &amp; LEAK PROTECTION" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Set the Windows system proxy while connected" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding SetSystemProxy}" Margin="0,0,0,14" />
                    <CheckBox Content="Block IPv6 inside the tunnel" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding BlockIpv6}" Margin="0,0,0,14" />
                    <CheckBox Content="Block QUIC (UDP/443)" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding BlockQuic}" Margin="0,0,0,14" />
                    <CheckBox Content="Send local network traffic direct" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding BypassLan}" Margin="0,0,0,14" />
                    <CheckBox Content="Block BitTorrent" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding BlockBitTorrent}" Margin="0,0,0,14" />
                    <CheckBox Content="Reconnect automatically if the tunnel drops" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding AutoReconnect}" Margin="0,0,0,14" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="DNS resolver" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Queries go through the tunnel as DNS-over-HTTPS."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <TextBox Style="{StaticResource DarkTextBox}" Width="286" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Text="{Binding DnsServer}" />
                    </Grid>

                    <Border Background="#12FF5C6C" BorderBrush="#33FF5C6C" BorderThickness="1"
                            CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <CheckBox Content="Allow invalid TLS certificates (not recommended)"
                                      Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AllowInsecureTls}" />
                            <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                                       Text="Imported configs can never enable this by themselves. Turning it on lets a network attacker impersonate your server." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- windows integration -->
            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="WINDOWS INTEGRATION" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text=".npvt file association" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding AssociationStatus}" Style="{StaticResource RowHint}" />
                            <TextBlock Text="Registered for the current user only — no admin rights required. Double-clicking a .npvt imports it straight into the library."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button Content="TOGGLE" Style="{StaticResource GhostButton}"
                                FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ToggleAssociationCommand}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Adds a per-user Run entry. No scheduled task, no service."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="System proxy" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="If something still routes through the tunnel, restore the previous settings."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button Content="RESTORE" Style="{StaticResource GhostButton}"
                                FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding RestoreProxyCommand}" />
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="App data" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Encrypted profile store, redacted logs and runtime files."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button Content="OPEN FOLDER" Style="{StaticResource GhostButton}"
                                FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding OpenDataFolderCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Section}">
                <StackPanel>
                    <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Version" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Right"
                                   Style="{StaticResource Mono}" FontSize="11.5" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Author" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="WasewaseX" HorizontalAlignment="Right" FontSize="12" />
                    </Grid>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Open source" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="MIT licensed. Tunnel engine: Xray-core (MPL-2.0)."
                                       Style="{StaticResource RowHint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
