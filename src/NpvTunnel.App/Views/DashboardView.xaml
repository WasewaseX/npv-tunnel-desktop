<UserControl x:Class="NpvTunnel.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NpvTunnel.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center">

            <!-- power ring -->
            <Grid x:Name="DialRoot" Width="250" Height="250" HorizontalAlignment="Center" Margin="0,14,0,0"
                  Cursor="Hand" MouseLeftButtonUp="OnDialClick" Background="Transparent">
                <Ellipse x:Name="Halo" Width="250" Height="250" Opacity="0"
                         Fill="{StaticResource AccentSoft}" />
                <Ellipse x:Name="Ring" Width="222" Height="222" StrokeThickness="1.6"
                         Stroke="{StaticResource StrokeBright}" />
                <Path x:Name="PowerGlyph"
                      Data="M12,3 L12,12 M6.6,6.6 A8,8 0 1 0 17.4,6.6"
                      Stretch="Uniform" Width="46" Height="46" StrokeThickness="1.9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{StaticResource Accent}" />
            </Grid>

            <!-- [ CONNECTED ] -->
            <TextBlock x:Name="Bracket" Text="{Binding StatusBracket}" HorizontalAlignment="Center"
                       Margin="0,26,0,0" FontFamily="{StaticResource MonoFont}" FontSize="15"
                       FontWeight="Bold" Foreground="{StaticResource Muted}" />

            <!-- active connection group card -->
            <Border Style="{StaticResource GroupCard}" Margin="0,22,0,0" Padding="0" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ACTIVE CONNECTION GROUP" Style="{StaticResource EyebrowCenter}"
                               Margin="0,16,0,14" />

                    <Grid Margin="22,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- the two-dot group mark -->
                        <Canvas Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Ellipse Canvas.Left="0" Canvas.Top="2" Width="11" Height="11" Fill="{StaticResource Accent}" />
                            <Ellipse Canvas.Left="7" Canvas.Top="9" Width="9" Height="9" Fill="{StaticResource Accent}" Opacity="0.75" />
                        </Canvas>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedProfile.Name, TargetNullValue=No configuration selected}"
                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedProfile.Endpoint, TargetNullValue=Import a .npvt or paste a share link}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                       Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedProfile.Chip, TargetNullValue=—}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Button Content="PING" Style="{StaticResource BaseButton}" Background="Transparent"
                            BorderBrush="Transparent" Foreground="{StaticResource Teal}" FontSize="12"
                            FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,6"
                            Command="{Binding PingAllCommand}" />

                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,4,0,0" />

                    <Grid Margin="22,16,22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DOWNLINK" Style="{StaticResource Eyebrow}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding DownlinkTotal}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="UPLINK" Style="{StaticResource Eyebrow}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding UplinkTotal}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- live rates + detail, the one place the desktop adds information -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DownloadText}" HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="DOWN" Style="{StaticResource EyebrowCenter}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UploadText}" HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource Amber}" />
                    <TextBlock Text="UP" Style="{StaticResource EyebrowCenter}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusDetail}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Muted}"
                       MaxWidth="470" Margin="0,18,0,20" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
