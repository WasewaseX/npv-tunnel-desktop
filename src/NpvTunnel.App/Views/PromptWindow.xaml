<Window x:Class="NpvTunnel.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NPV Tunnel" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="Background" Value="#FF0A120E" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBright}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource StrokeBright}"
            BorderThickness="1" CornerRadius="10" Padding="22" MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="10" Opacity="0.6" Color="#FF000000" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="UNLOCK CONFIG" Style="{StaticResource EyebrowAccent}" />
            <TextBlock Text="Locked configuration" Style="{StaticResource H2}" Margin="0,8,0,0" />
            <TextBlock x:Name="PromptText" Margin="0,8,0,16" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{StaticResource Muted}" />
            <PasswordBox x:Name="PassphraseBox" Style="{StaticResource DarkPasswordBox}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="CANCEL" Style="{StaticResource GhostButton}" Click="OnCancel" IsCancel="True"
                        FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="0,0,10,0" />
                <Button Content="UNLOCK" Style="{StaticResource PrimaryButton}" Click="OnAccept" IsDefault="True"
                        FontFamily="{StaticResource MonoFont}" FontSize="10.5" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
