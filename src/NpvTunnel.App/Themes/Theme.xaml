<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         Palette taken from the NPV Tunnel design language: near-black green
         canvas, mint accents, teal for latency, amber for uplink, hairline
         borders, monospaced uppercase labels with wide tracking.
         ====================================================================== -->
    <Color x:Key="BgDeepColor">#FF060C09</Color>
    <Color x:Key="BgColor">#FF0A120E</Color>
    <Color x:Key="CardColor">#FF0F1714</Color>
    <Color x:Key="CardAltColor">#FF122019</Color>
    <Color x:Key="ActiveColor">#FF132C20</Color>
    <Color x:Key="StrokeColor">#FF1E2A24</Color>
    <Color x:Key="StrokeBrightColor">#FF2C4038</Color>
    <Color x:Key="AccentColor">#FF3FE58F</Color>
    <Color x:Key="AccentDeepColor">#FF1EC7A8</Color>
    <Color x:Key="TealColor">#FF37D6C9</Color>
    <Color x:Key="AmberColor">#FFE9B44C</Color>
    <Color x:Key="DangerColor">#FFFF5C6C</Color>
    <Color x:Key="WarningColor">#FFE9B44C</Color>
    <Color x:Key="TextColor">#FFE8F1EC</Color>
    <Color x:Key="MutedColor">#FF7E8F86</Color>

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardAlt" Color="{StaticResource CardAltColor}" />
    <SolidColorBrush x:Key="Active" Color="{StaticResource ActiveColor}" />
    <SolidColorBrush x:Key="Stroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeBright" Color="{StaticResource StrokeBrightColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentColor}" Opacity="0.13" />
    <SolidColorBrush x:Key="AccentBorder" Color="{StaticResource AccentColor}" Opacity="0.40" />
    <SolidColorBrush x:Key="AmberSoft" Color="{StaticResource AmberColor}" Opacity="0.14" />

    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF08100C" Offset="0" />
        <GradientStop Color="#FF0A120E" Offset="0.6" />
        <GradientStop Color="#FF070E0B" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3FE58F" Offset="0" />
        <GradientStop Color="#FF1EC7A8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3FE58F" Offset="0" />
        <GradientStop Color="#FF37D6C9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#143FE58F" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Inter, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================ text ============================ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- mono, uppercase, wide tracking: the signature label of this UI -->
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="EyebrowAccent" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="MonoValue" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- ============================ surfaces ============================ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="TileStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource CardAlt}" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="GroupRowStyle" TargetType="Border">
        <Setter Property="Background" Value="#FF161D19" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="14,11" />
    </Style>

    <Style x:Key="Hairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Stroke}" />
    </Style>

    <!-- ============================ buttons ============================ -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="#FF04241B" />
        <Setter Property="BorderBrush" Value="#00000000" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBright}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="#14FF5C6C" />
        <Setter Property="BorderBrush" Value="#3DFF5C6C" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- round "+" button of the floating action bar -->
    <Style x:Key="RoundAccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="Foreground" Value="#FF04241B" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="21">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ nav ============================ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="18" Padding="16,9">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#0AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ inputs ============================ -->
    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Background" Value="#FF0A120E" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="20" CornerRadius="10"
                                Background="#FF16211B" BorderBrush="{StaticResource StrokeBright}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FF6E7F76"
                                     HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio option drawn as a mint ring, as in the reference client -->
    <Style x:Key="RingRadio" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,12,0">
                            <Ellipse Stroke="{StaticResource StrokeBright}" StrokeThickness="1.6" />
                            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource Accent}" Opacity="0" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ lists / scroll ============================ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Margin="1,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CleanListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,7" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Root" Background="Transparent" CornerRadius="7">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#08FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ window chrome ============================ -->
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FFE81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Android-parity surfaces (NPV Tunnel 124.x layout) ===== -->
    <SolidColorBrush x:Key="Row" Color="#FF0E1512" />
    <SolidColorBrush x:Key="RowTint" Color="#FF16321F" />
    <SolidColorBrush x:Key="RowTintStroke" Color="#FF2C6B45" />
    <SolidColorBrush x:Key="PillBg" Color="#FF12301F" />
    <SolidColorBrush x:Key="PillStroke" Color="#FF234A35" />
    <SolidColorBrush x:Key="NavBar" Color="#FF0B110E" />
    <SolidColorBrush x:Key="NavPill" Color="#FF10312A" />

    <Style x:Key="GroupCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Row}" />
        <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- One nav entry: icon above a mono caption, exactly like the phone. -->
    <Style x:Key="BottomNav" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border x:Name="Pill" Width="54" Height="30" CornerRadius="15"
                                Background="Transparent" HorizontalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="Caption" Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9.5" FontWeight="Bold"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource NavPill}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Teal}" />
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Teal}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Text}" />
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon button used inside group rows. -->
    <Style x:Key="RowIcon" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="EyebrowCenter" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
